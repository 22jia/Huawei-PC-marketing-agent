# Copy to .env locally. Never commit real credentials.
# Runtime retrieval uses the checked-in local knowledge base first.
LOCAL_KNOWLEDGE_BASE_PATH=./华为PC全板块深度知识库_v7
VMALL_BASE_URL=https://www.vmall.com/
PORT=3000
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Whole model request, including response body; bounded to at most 300000 ms.
LLM_TIMEOUT_MS=120000
# Conservative for planning and review; generation can use a warmer value.
LLM_TEMPERATURE=0.3
LLM_COPY_TEMPERATURE=0.6

# Server-side image subagent. Full generations endpoint, never expose the key to Vite.
IMAGE_PROVIDER=openai-next
IMAGE_BASE_URL=https://api.openai-next.com/v1/images/generations
CREDIT_MEDIA_API_KEY=
IMAGE_MODEL=gpt-image-2
IMAGE_TIMEOUT_MS=180000
IMAGE_MAX_IMAGES=3
# Default: model edits the official reference directly, using the same image Key.
IMAGE_GENERATION_MODE=reference_edit
IMAGE_EDIT_URL=https://api.openai-next.com/v1/images/edits
# Optional legacy composition mode only; not required for reference_edit.
REMOVE_BG_API_KEY=

# Shared automatic revision budget (0-8), and elapsed draft/review budget in ms
AGENT_MAX_REVISIONS=4
AGENT_REPAIR_TIMEOUT_MS=180000

# Maximum simultaneous conversation jobs in this backend process; each session stays serial.
AGENT_MAX_CONCURRENT=4
