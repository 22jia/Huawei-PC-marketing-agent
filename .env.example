# Copy to .env locally. Never commit real credentials.
# Runtime retrieval uses the checked-in local knowledge base first.
LOCAL_KNOWLEDGE_BASE_PATH=./华为PC全板块深度知识库_v7
VMALL_BASE_URL=https://www.vmall.com/
PORT=3000
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Per text-model request, milliseconds (maximum 300000).
LLM_TIMEOUT_MS=180000
# Optional image generation. Keep the real key in the local environment only.
# OpenAI Next media API is used when IMAGE_PROVIDER is omitted and a key exists.
IMAGE_PROVIDER=openai-next
CREDIT_MEDIA_API_KEY=
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.openai-next.com/v1/images/generations
IMAGE_MODEL=gpt-image-2
IMAGE_SIZE=1024x1024
# Exact HTTPS CDN hostnames allowed for provider-returned URLs (comma-separated).
IMAGE_DOWNLOAD_HOSTS=api.openai-next.com
IMAGE_TIMEOUT_MS=180000
# Workbench image mode can generate up to three requested variants.
IMAGE_MAX_IMAGES=3
GENERATED_ASSET_DIR=./tmp/generated-assets

# Optional remove.bg background removal for opaque official product images.
# Separate service key; transparent product PNGs do not require this.
REMOVE_BG_API_KEY=
